# Copy this file to ".env" (same folder) and adjust if your setup differs.
# ".env" is in .gitignore, so your local settings are never published.

# SQL Server (the LusitaniaOLTP source from Project 1)
SQL_SERVER=localhost
SQL_DRIVER=ODBC Driver 18 for SQL Server
OLTP_DATABASE=LusitaniaOLTP

# MongoDB (the online store)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=lusitania_online

# Public exchange-rate API (European Central Bank rates, no key needed)
FX_API_URL=https://api.frankfurter.app
FX_BASE=EUR
FX_SYMBOLS=GBP,USD
FX_START=2025-01-01

# Where the lakehouse files live (relative to the project folder)
DATA_DIR=data
